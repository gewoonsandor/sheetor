{
  "name": "sheetor",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --workspace @sheetor/frontend run dev",
    "dev:backend": "npm --workspace @sheetor/backend run dev",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm --workspace @sheetor/frontend run build",
    "build:backend": "npm --workspace @sheetor/backend run build",
    "lint": "npm run lint --workspaces --if-present",
    "start:backend": "npm --workspace @sheetor/backend run start"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
